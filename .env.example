# --- Client ------------------------------------------------------------------
# Ces deux valeurs sont intégrées dans le bundle livré au navigateur. C'est le
# modèle de Supabase : la clé anon est publique, la sécurité vient des politiques
# RLS du schéma, pas du secret de la clé.
VITE_SUPABASE_URL=https://REMPLACEZ-VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=a copier depuis Project Settings > API > anon public

# --- Outils (jamais exposé au navigateur) ------------------------------------
# Sert uniquement à scripts/seed.mjs, qui crée les comptes de démo et charge le
# référentiel. L'absence de préfixe VITE_ empêche Vite de l'injecter dans le code.
# ⚠️ Cette clé outrepasse la RLS : ne la commitez pas, ne la partagez pas.
SUPABASE_SERVICE_ROLE_KEY=
